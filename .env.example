# Copy to .env and fill in your keys:  cp .env.example .env

# --- Required ---
OPENAI_API_KEY=sk-...                 # Embeddings + reranker (always OpenAI)
GEMINI_API_KEY=...                    # Chat model (default: gemini-2.5-flash)

# --- Optional ---
# ANTHROPIC_API_KEY=sk-ant-...        # Only needed if MODEL uses a Claude model
# MODEL=gemini-2.5-flash              # Chat model (provider inferred from name)
# RERANK_MODEL=gpt-4.1-nano           # Reranker model (provider inferred from name)
# TOP_K=5                             # Number of chunks to retrieve
# MAX_TOKENS=600                      # Max output tokens per response
