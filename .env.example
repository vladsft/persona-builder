# Copy to .env and fill in your keys:  cp .env.example .env

# --- Required (at least one chat provider + OpenAI for embeddings) ---
ANTHROPIC_API_KEY=sk-ant-...          # Anthropic (A/B variant: claude-sonnet-4-6, claude-haiku-4-5)
OPENAI_API_KEY=sk-...                 # Embeddings (always OpenAI) + reranker
DEEPSEEK_API_KEY=sk-...               # DeepSeek (A/B variant: deepseek-chat)
GEMINI_API_KEY=...                    # Google (A/B variant: gemini-2.5-flash)

# --- Deployment ---
# DEPLOYMENT=web                      # Set to "web" on Streamlit Cloud to enable rate limits
# KILL_SWITCH=0                       # Set to "1" to instantly disable the app

# --- Rate Limits (web deployment only) ---
# MAX_SESSIONS_PER_IP=3               # Max new sessions per IP per 24h
# DAILY_SESSION_CAP=300               # Global max sessions per day

# --- Model / retrieval tuning ---
# TOP_K=5                             # Number of chunks to retrieve
# MAX_TOKENS=600                      # Max output tokens per response
# RERANK_MODEL=gpt-4.1-nano           # Reranker model (provider inferred from name)
